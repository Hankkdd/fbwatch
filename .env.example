# 複製成 .env 後填入。.env 不要進版控。

# 容器內 Chrome 的 UID，必須跟 chrome-profile 目錄的擁有者一致。
# 填 `id -u` 的結果。不一致的症狀是「每次重啟都要重新登入」，離成因很遠。
HOST_UID=1000


PG_PASSWORD=
PG_PORT=55432

# noVNC 與 MinIO console 的綁定位址。
#
# 預設只綁本機。要從別台機器連，填那張網卡的位址，但請走 Tailscale、
# WireGuard 之類的私有網路 —— 不要綁 0.0.0.0：noVNC 後面是一個已經登入
# 你 Facebook 帳號的瀏覽器，等於把帳號放到公網上。
BIND_IP=127.0.0.1
NOVNC_PORT=6080
VNC_PASSWORD=

# 要追哪些社團、關鍵字、賣場：複製 config/seed.example.yaml 成 config/seed.yaml。

# Discord 頻道設定 → 整合 → Webhook → 複製 Webhook 網址
# 這是密鑰，任何人拿到都能對你的頻道發文。.env 已在 .gitignore 裡。
#
# 這是預設管道：告警、熔斷、賣貨便變動一律走這裡。
DISCORD_WEBHOOK_URL=

# 社團可以各自通知到不同聊天室。做法是在 groups.webhook_env 填變數名稱，
# 再在這裡設同名變數，例如：
#
#   UPDATE groups SET webhook_env = 'DISCORD_WEBHOOK_URL_B' WHERE id = '...';
#   DISCORD_WEBHOOK_URL_B=https://discord.com/api/webhooks/...
#
# 資料庫只存名稱不存網址，憑證統一留在這個檔案 —— 不然 pg_dump 出來的檔案
# 就帶著一把可以對那個頻道發文的鑰匙。新增管道要重啟容器才讀得到。
# DISCORD_WEBHOOK_URL_B=

# 設 1 讓容器啟動後自動持續輪詢。
# 換帳號或重新登入時先設 0，避免用空的 profile 輪詢而立刻觸發熔斷。
FBWATCH_LOOP=0

# Chrome profile 目錄（登入態存放處）。換帳號時改指到另一個目錄，
# 不要在同一個 profile 上登出再登入。
PROFILE_DIR=./chrome-profile

# 輪詢節奏（秒）。留空用預設：日間 90–240、夜間 600–1200，下限保護 30 秒。
FBWATCH_POLL_DAY_MIN=
FBWATCH_POLL_DAY_MAX=
FBWATCH_POLL_NIGHT_MIN=
FBWATCH_POLL_NIGHT_MAX=
# 夜間視窗的起訖整點（含起、不含訖），預設 2–6。
# 邊界會隨社團的作息改變：實測 01 點的貼文量跟下午同級，放進夜間會白等 5 分鐘。
FBWATCH_NIGHT_START=
FBWATCH_NIGHT_END=

# 每輪補抓詳情頁的上限（預設 3）
FBWATCH_BODIES_PER_CYCLE=

# MinIO（圖片儲存）。本機 9000 已被佔用，API 預設改用 59000。
# console 綁在 BIND_IP 上，可從自己的電腦瀏覽已抓到的圖片。
MINIO_USER=fbwatch
MINIO_PASSWORD=
MINIO_BUCKET=listing-images
MINIO_PORT=59000
MINIO_CONSOLE_PORT=59001

# ── 選配：給外部比價 bot 查貼文的唯讀 MCP 服務 ──────────────────────
#
# 預設不啟動。只要監控與通知的話，這整段可以不管。
# 要啟動就把下面三行的註解拿掉（COMPOSE_PROFILES 讓 docker compose up 一併帶它）。
# 兩個密鑰都用 openssl rand -hex 32 產生。
#
# COMPOSE_PROFILES=mcp
# FBWATCH_BOT_NETWORK=      # bot 那邊既有的 docker 網路名稱，mcp 會接上去
# FBWATCH_MCP_PG_PASSWORD=   # 唯讀資料庫帳號 fbwatch_mcp 的密碼，collector 啟動時會套用
# FBWATCH_MCP_TOKEN=         # bot 連 MCP 時要帶的 Bearer token；沒設服務會拒絕啟動

# 命中 keywords.summon = true 的主題時，在通知裡 tag 這個 Discord 使用者（比價 bot）。
# 空的話不叫。值是 bot 的使用者 ID（Discord 開發者模式右鍵複製）。
FBWATCH_SUMMON_USER_ID=

# 選填：Agent Hub 的網址與 token，有設才提供影片逐字稿工具
AGENT_HUB_URL=
AGENT_HUB_TOKEN=
