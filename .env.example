# 複製成 .env 後填入。.env 不要進版控。

PG_PASSWORD=
PG_PORT=55432

# noVNC 綁定位址。用 Tailscale IP，不要用 0.0.0.0。
BIND_IP=100.111.198.3
NOVNC_PORT=6080
VNC_PASSWORD=

# 社團 ID，逗號分隔
# 150336012291472  小人模型跳蚤市場（公開）
# 236748899853629  Taiwan Wargame Miniature Marketplace（私密）
# 227104705681276  戰錘warhammer 微縮模型殺肉交易所（私密）
FBWATCH_GROUPS=150336012291472,236748899853629,227104705681276

# Discord 頻道設定 → 整合 → Webhook → 複製 Webhook 網址
# 這是密鑰，任何人拿到都能對你的頻道發文。.env 已在 .gitignore 裡。
DISCORD_WEBHOOK_URL=

# 設 1 讓容器啟動後自動持續輪詢。
# 換帳號或重新登入時先設 0，避免用空的 profile 輪詢而立刻觸發熔斷。
FBWATCH_LOOP=0

# Chrome profile 目錄（登入態存放處）。換帳號時改指到另一個目錄，
# 不要在同一個 profile 上登出再登入。
PROFILE_DIR=./chrome-profile

# 輪詢節奏（秒）。留空用預設：日間 90–240、夜間 600–1200，下限保護 30 秒。
FBWATCH_POLL_DAY_MIN=
FBWATCH_POLL_DAY_MAX=
FBWATCH_POLL_NIGHT_MIN=
FBWATCH_POLL_NIGHT_MAX=

# 每輪補抓詳情頁的上限（預設 3）
FBWATCH_BODIES_PER_CYCLE=
